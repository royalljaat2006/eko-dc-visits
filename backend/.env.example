# Local dev only. Copy to backend/.env and fill in — that file is git-ignored
# (root .gitignore matches `.env` at any depth) and loaded automatically by
# `npm run dev` (backend/src/index.ts -> "dotenv/config"). Never used by the
# self-hosted Docker image, which injects real env vars directly — see
# infra/self-hosted/.env.example.

# Login OTP without real SMS (local dev only: the 000000 dev stub applies if this is unset; it is disabled in production).
# PILOT_OTP=123456

# Real SMS OTP — ekoicici product (api.eko.in/ekoicici/v3). All four required
# together to switch on — leave any one unset and the server silently keeps
# using PILOT_OTP above (see backend/src/auth/eko.ts).
# initiator_id and user_code are FIXED account credentials, never a phone
# number. csp_id/mobile are the caller's own number, set per request.
# EKO_DEVELOPER_KEY=
# EKO_ACCESS_KEY=
# EKO_INITIATOR_ID=
# EKO_USER_CODE=
# EKO_BASE_URL=https://api.eko.in/ekoicici/v3

# Postgres + PostGIS. Unset -> in-memory repos seeded from fixtures (default).
# DATABASE_URL=postgres://user:pass@localhost:5432/dcvisits

# Accept LAN connections (needed so a phone on the same Wi-Fi can reach this
# backend instead of only the emulator's 10.0.2.2 loopback alias).
# HOST=0.0.0.0

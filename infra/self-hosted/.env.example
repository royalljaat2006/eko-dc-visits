# Copy to .env and fill in. Never commit .env.

# No domain yet: the Caddyfile is set to serve plain HTTP on :80 (IP+path,
# e.g. http://<server-ip>/api/v1/...) — API_DOMAIN isn't used and doesn't need
# setting. Once you have a domain, point its DNS record here, open 80+443,
# edit infra/self-hosted/Caddyfile to use that hostname instead of `:80`
# (see the comment there), and Caddy will provision HTTPS automatically.

# Postgres (the DB is internal to the compose network; pick a strong password).
POSTGRES_DB=dcvisits
POSTGRES_USER=dcvisits
POSTGRES_PASSWORD=change-me-long-random

# Session token signing — 32+ random chars. `openssl rand -hex 32`
JWT_SECRET=change-me-32-plus-random-hex

# The login OTP every enrolled user types (replaces the dev stub 000000).
# Distribute it out-of-band. Rotate it by changing this + restarting `api`.
# Ignored once the EKO_* vars below are all set — real SMS OTP takes over.
PILOT_OTP=change-me-6-digit

# Real SMS OTP — ekoicici product (api.eko.in/ekoicici/v3). This is a LIVE,
# BILLED account — every Send OTP call sends a real SMS at real cost.
# Leave any of the four unset to keep using PILOT_OTP above (e.g. for a demo).
# EKO_BASE_URL=https://api.eko.in/ekoicici/v3
# EKO_DEVELOPER_KEY=            # fixed account credential
# EKO_ACCESS_KEY=               # signs secret-key; never sent on the wire
# EKO_INITIATOR_ID=             # fixed account credential, never a phone number
# EKO_USER_CODE=                # fixed account credential
# (csp_id/mobile are the caller's own number, set per request — see backend/src/auth/eko.ts)

LOG_LEVEL=info

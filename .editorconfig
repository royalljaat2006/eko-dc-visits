# Canonical formatting for every editor / CI check. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JVM side of the repo follows Kotlin/Android conventions (4-space).
[*.{kt,kts}]
indent_size = 4

[*.java]
indent_size = 4

[*.gradle]
indent_size = 4

[Makefile]
indent_style = tab

# Markdown uses two trailing spaces for hard line breaks — don't strip them.
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
